#!/usr/bin/env bash
# Make cached first-frame thumbnails for video files named in notifications.
#
# Usage: glance-thumb <absolute-video-path>...
# Prints one JSON object per thumbnail that exists after the run:
#   {"file":"/path/video.mp4","thumb":"/state/omarchy-glance/thumbs/<md5>.jpg"}
#
# Paths come from notification data, so each one must resolve inside the user's
# XDG videos directory to a regular, readable video file. Anything else is
# skipped silently.
set -uo pipefail
umask 077

state_home="${XDG_STATE_HOME:-$HOME/.local/state}"
glance_state="$state_home/omarchy-glance"
thumbs="$glance_state/thumbs"
max_files=30
width=480

[[ ! -L "$glance_state" && ! -L "$thumbs" ]] || exit 0
mkdir -p -- "$thumbs" || exit 0
[[ -d "$glance_state" && ! -L "$glance_state" && -d "$thumbs" && ! -L "$thumbs" ]] || exit 0
chmod 700 -- "$glance_state" "$thumbs" 2>/dev/null || true

# Resolve the trusted XDG videos directory. Never allow $HOME itself or / if
# xdg-user-dir falls back to $HOME when XDG_VIDEOS_DIR is unconfigured.
home_real=$(realpath -e -- "$HOME" 2>/dev/null || printf '%s' "$HOME")
videos_dir=""
if command -v xdg-user-dir >/dev/null 2>&1; then
  videos_dir=$(xdg-user-dir VIDEOS 2>/dev/null || true)
fi
if [[ -z "$videos_dir" || "$videos_dir" == "$HOME" || "$videos_dir" == "$home_real" || "$videos_dir" == "/" ]]; then
  videos_dir="$HOME/Videos"
fi
videos_real=$(realpath -e -- "$videos_dir" 2>/dev/null || true)
if [[ -z "$videos_real" || ! -d "$videos_real" || "$videos_real" == "/" || "$videos_real" == "$home_real" ]]; then
  exit 0
fi

# Keep the cache small: thumbnails nobody has needed for 30 days go.
find "$thumbs" -maxdepth 1 -type f -name '*.jpg' -mtime +30 -delete 2>/dev/null || true

make_thumb() {
  local src="$1" out="$2" tmp
  [[ ! -L "$out" ]] || rm -f -- "$out"
  tmp=$(mktemp "$thumbs/.thumb.XXXXXX.jpg") || return 1
  chmod 600 -- "$tmp"
  if command -v ffmpegthumbnailer >/dev/null 2>&1; then
    timeout 10 nice -n 19 ffmpegthumbnailer -i "$src" -o "$tmp" -s "$width" -q 7 -c jpeg >/dev/null 2>&1
  elif command -v ffmpeg >/dev/null 2>&1; then
    timeout 10 nice -n 19 ffmpeg -nostdin -loglevel error -y -protocol_whitelist file -ss 0.5 -i "$src" \
      -frames:v 1 -vf "scale=$width:-2" -f image2 "$tmp" >/dev/null 2>&1
  else
    false
  fi
  local status=$?
  if (( status == 0 )) && [[ -s $tmp ]]; then
    mv -f -- "$tmp" "$out"
  else
    rm -f -- "$tmp"
    return 1
  fi
}

count=0
for src in "$@"; do
  (( count++ < max_files )) || break
  [[ $src == /* && $src != *$'\n'* && $src != *$'\r'* ]] || continue
  [[ ${src,,} =~ \.(mp4|mkv|webm|mov|avi)$ ]] || continue
  [[ -f $src && -r $src ]] || continue

  src_real=$(realpath -e -- "$src" 2>/dev/null || true)
  [[ -n $src_real && -f $src_real && -r $src_real ]] || continue
  [[ ${src_real,,} =~ \.(mp4|mkv|webm|mov|avi)$ ]] || continue
  [[ $src_real == "$videos_real/"* ]] || continue

  hash=$(printf '%s' "$src_real" | md5sum | cut -d' ' -f1)
  out="$thumbs/$hash.jpg"

  if [[ ! -s $out || $src_real -nt $out || -L $out ]]; then
    make_thumb "$src_real" "$out" || continue
  else
    touch -- "$out" 2>/dev/null || true
  fi

  jq -cn --arg file "$src" --arg thumb "$out" '{file: $file, thumb: $thumb}'
done
