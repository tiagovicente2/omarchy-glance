#!/usr/bin/env bash
set -euo pipefail

state_home="${XDG_STATE_HOME:-$HOME/.local/state}"
config_home="${XDG_CONFIG_HOME:-$HOME/.config}"
glance_state="$state_home/omarchy-glance"
nc_state="$state_home/omarchy-notification-center"
nc_bin="$config_home/omarchy/plugins/jankeesvw.notification-center/bin/notification-center"
popups="$state_home/omarchy/notifications"
history="$state_home/omarchy/notifications/history"

mkdir -p "$glance_state"

get_seen() {
  local s1=0 s2=0
  [[ -f "$glance_state/seen" ]] && s1=$(cat "$glance_state/seen" 2>/dev/null || echo 0)
  [[ -f "$nc_state/seen" ]] && s2=$(cat "$nc_state/seen" 2>/dev/null || echo 0)
  [[ "$s1" =~ ^[0-9]+$ ]] || s1=0
  [[ "$s2" =~ ^[0-9]+$ ]] || s2=0
  if (( s1 > s2 )); then
    echo "$s1"
  else
    echo "$s2"
  fi
}

cmd_unread() {
  local seen
  seen=$(get_seen)

  local files=()
  [[ -f "$popups/live.json" && -s "$popups/live.json" ]] && files+=("$popups/live.json")
  [[ -f "$popups/history.json" && -s "$popups/history.json" ]] && files+=("$popups/history.json")

  while IFS= read -r f; do
    [[ -n "$f" && -s "$f" ]] && files+=("$f")
  done < <(find "$popups" "$history" -maxdepth 1 -type f -name '*.json' ! -name 'live.json' ! -name 'history.json' ! -name 'quiet.json' 2>/dev/null)

  local count=0
  if (( ${#files[@]} > 0 )); then
    count=$(
      jq -r -s --argjson seen "$seen" '
        def to_entries:
          if type == "array" then .[]
          elif type == "object" then .
          else empty
          end;
        [ .[]? | to_entries | select(.key or .id or .originalId or .ts or .timestamp) | .timestamp = (if .timestamp then .timestamp elif .ts then (.ts * 1000 | floor) else 0 end) ]
        | unique_by(.key // (.timestamp|tostring))
        | [ .[] | select(.timestamp > $seen) ]
        | length
      ' "${files[@]}" 2>/dev/null || echo 0
    )
  fi

  count=$(echo "$count" | tr -cd '0-9')
  [[ -n "$count" ]] || count=0

  printf '{"ok":true,"unread":%d}\n' "$count"
}

cmd_mark_seen() {
  local stamp="${1:-}"
  if [[ -z "$stamp" || ! "$stamp" =~ ^[0-9]+$ ]]; then
    stamp="$(($(date +%s%N) / 1000000))"
  fi

  printf '%s\n' "$stamp" > "$glance_state/seen"
  if [[ -d "$nc_state" ]]; then
    printf '%s\n' "$stamp" > "$nc_state/seen" 2>/dev/null || true
  fi

  if [[ -x "$nc_bin" ]]; then
    "$nc_bin" seen "$stamp" >/dev/null 2>&1 || true
  fi

  printf '{"ok":true,"seen":%s}\n' "$stamp"
}

cmd_watch() {
  mkdir -p "$popups" "$history" "$glance_state"
  [[ -d "$nc_state" ]] || mkdir -p "$nc_state" 2>/dev/null || true

  command -v inotifywait >/dev/null 2>&1 || {
    while true; do sleep 5; echo "poll"; done
    exit 0
  }

  exec inotifywait -m -q -e close_write -e moved_to -e delete --format '%e %w%f' \
    "$popups" "$history" "$glance_state" "$nc_state" 2>/dev/null
}

case "${1:-}" in
  unread)    cmd_unread ;;
  mark-seen) shift; cmd_mark_seen "$@" ;;
  seen)      printf '{"ok":true,"seen":%s}\n' "$(get_seen)" ;;
  watch)     cmd_watch ;;
  *)         echo "Usage: glance-unread {unread|mark-seen [timestamp]|seen|watch}" >&2; exit 1 ;;
esac
